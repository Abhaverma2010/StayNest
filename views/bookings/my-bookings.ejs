<% layout('layouts/boilerplate') %>

<div class="container mt-4">
    <h2>My Bookings</h2>
    <hr>

    <% if (bookings.length === 0) { %>
        <div class="alert alert-info">
            You have no bookings yet. 
            <a href="/listings">Browse listings</a>
        </div>

    <% } else { %>
        <div class="row">
            <% for (let booking of bookings) { %>
                <% if (booking.listing) { %>
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm">
                        <% if (booking.listing.image && booking.listing.image.url) { %>
                            <img src="<%= booking.listing.image.url %>" class="card-img-top" style="height:200px; object-fit:cover;">
                        <% } %>
                        <div class="card-body">
                            <h5 class="card-title"><%= booking.listing.title %></h5>
                            <p class="text-muted mb-1">📍 <%= booking.listing.location %>, <%= booking.listing.country %></p>
                            <p class="mb-1">📅 <b>Check-in:</b> <%= booking.checkIn.toDateString() %></p>
                            <p class="mb-1">📅 <b>Check-out:</b> <%= booking.checkOut.toDateString() %></p>
                            <p class="mb-1">💰 <b>Total:</b> ₹<%= booking.totalPrice %></p>
                            <span class="badge 
                                <%= booking.status === 'confirmed' ? 'bg-success' : 
                                    booking.status === 'cancelled' ? 'bg-danger' : 'bg-warning' %>">
                                <%= booking.status.toUpperCase() %>
                            </span>

                            <% if (booking.status !== 'cancelled') { %>
                                <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST" class="mt-3">
                                    <button class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Cancel this booking?')">
                                        Cancel Booking
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% } %>
            <% } %>
        </div>
    <% } %>
</div>